PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bulkmail

# frontend url(s), comma separated, no trailing slash
CLIENT_URL=http://localhost:5173

# admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
JWT_SECRET=put-a-long-random-string-here

# Gmail API (OAuth 2.0)
GMAIL_USER=yourname@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# max recipients per request
MAX_RECIPIENTS=100
